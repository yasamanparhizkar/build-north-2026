{
  "manifest_version": 3,
  "name": "Senior Helper Pointer",
  "version": "1.1",
  "description": "Listens to a family member on Google Meet and points at the right button on the senior's screen.",
  "permissions": ["activeTab", "scripting", "storage", "tabCapture", "offscreen", "tabs"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}

}
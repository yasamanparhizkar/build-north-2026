{
  "name": "senior-helper-extension",
  "version": "1.2.0",
  "private": true,
  "description": "Chrome extension that points at the right button for seniors, guided by a family member's voice on Google Meet.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.mjs\"",
    "test:all": "npm test && npm run test:integration"
  },
  "devDependencies": {
    "puppeteer": "^24.43.1"
  }
}
